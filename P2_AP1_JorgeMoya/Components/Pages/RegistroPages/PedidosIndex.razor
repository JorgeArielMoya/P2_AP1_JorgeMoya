@page "/Pedidos/Index"
@inject PedidosService pedidosService
@rendermode InteractiveServer

<div class="container mt-3">
    <div class="card shadow-lg">
        <div class="card-header">
            <h5 class="card-title text-center"> <strong> Consulta de Registros </strong></h5>

            <div class="d-flex justify-content-end">
                <a class="btn btn-primary bi bi-plus-square" href="/Registro/Create"> Crear Registro</a>
            </div>
        </div>

        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-12 col-md-6 mb-3">
                    <label class="form-label"> <strong> Desde: </strong></label>
                    <InputDate class="form-control" @bind-Value = "Desde"/>
                </div>

                <div class="col-12 col-md-6 mb-3">
                    <label class="form-label"> <strong> Hasta: </strong></label>
                    <InputDate class="form-control" @bind-Value="Hasta" />
                </div>
            </div>

            <div class="row align-items-center">
                <div class="col-12 col-md-6 mb-3">
                    <label class="form-label"> <strong> Busqueda: </strong></label>
                    <div class="input-group">
                        <input class="form-control"/>
                        <button type="button" class="btn btn-outline-info bi bi-search"> </button>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover table-striped"> 
                    <thead>
                        <tr>
                            <th> ID </th>
                            <th> Fecha </th>
                            <th> Opciones </th>
                        </tr>
                    </thead>

                    <tr>
                        <td> Id </td>
                        <td> Fecha </td>
                        <td> <a class="btn btn-outline-info bi bi-pencil-square"> </a></td>
                    </tr>

                </table>
            </div>
        </div>
    </div>
</div>

@code {
    public DateTime? Desde { get; set; } 

    public DateTime? Hasta { get; set; } 

    public List<Pedidos> ListaPedidos = new List<Pedidos>();

    public async Task Buscar ()
    {
        var lista = await pedidosService.Listar(r => true);

        if (Desde.HasValue && Desde.HasValue)
        {
            lista = lista.Where(p => p.Fecha >= Desde && p.Fecha <= Hasta).ToList() ;
        }

        ListaPedidos = lista;
    }
}
